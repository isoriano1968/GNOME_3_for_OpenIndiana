From fc4c05d65cc4fd447b25247de8db9cfb5d71a709 Mon Sep 17 00:00:00 2001
From: isoriano1968 <81116077+isoriano1968@users.noreply.github.com>
Date: Mon, 9 Nov 2026 12:42:02 +0100
Subject: [PATCH] NNNNN hal: GPT partitions of removable disks never become
 volumes

---
 usr/src/cmd/hal/probing/storage/probe-storage.c | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/usr/src/cmd/hal/probing/storage/probe-storage.c b/usr/src/cmd/hal/probing/storage/probe-storage.c
index 50bd78c..5001a04 100644
--- a/usr/src/cmd/hal/probing/storage/probe-storage.c
+++ b/usr/src/cmd/hal/probing/storage/probe-storage.c
@@ -4,6 +4,7 @@
  *
  * Copyright 2009 Sun Microsystems, Inc.  All rights reserved.
  * Use is subject to license terms.
+ * Copyright 2026 isoriano1968
  *
  * Licensed under the Academic Free License version 2.1
  *
@@ -455,6 +456,11 @@ main (int argc, char *argv[])
 		 */
 		is_gpt = TRUE;
 		scheme = "gpt";
+		/*
+		 * GPT partitions are slices s0..s6: let hald probe them, as
+		 * for VTOC slices, or they never become volumes.
+		 */
+		vtoc_slices = TRUE;
 		efi_free(gpt);
 	}
 
-- 
