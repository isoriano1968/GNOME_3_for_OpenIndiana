    Site profile delivered by system/hal/probe-storage-gpt: hald-runner
    looks in HALD_RUNNER_PATH before /usr/lib/hal, so hald uses the GPT
    capable prober and mount helpers in /usr/lib/hal/oi.  Removing the
    package removes this profile and the property with it.
-->
<service_bundle type="profile" name="system/hal/probe-storage-gpt">
	<service name="system/hal" version="1" type="service">
		<property_group name="start" type="method">
			<property name="environment" type="astring">
				<astring_list>
					<value_node value="HALD_RUNNER_PATH=/usr/lib/hal/oi"/>
				</astring_list>
			</property>
		</property_group>
	</service>
</service_bundle>
