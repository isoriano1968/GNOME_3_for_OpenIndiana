# Start method for svc:/system/polkit (contract service).

. /lib/svc/share/smf_include.sh

args=""
debug=`/usr/bin/svcprop -p options/debug "$SMF_FMRI" 2>/dev/null`
[ "$debug" = "true" ] || args="--no-debug"

/usr/lib/polkit-1/polkitd $args &

exit $SMF_EXIT_OK
