Not upstream: OpenIndiana.

W_EXITCODE is a glibc/BSD macro; illumos <sys/wait.h> does not have it.

--- a/src/terminal.cc
+++ b/src/terminal.cc
@@ -28,6 +28,10 @@
 #include <unistd.h>
 #include <sys/wait.h>
 
+#ifndef W_EXITCODE /* glibc/BSD only; illumos has no W_EXITCODE */
+#define W_EXITCODE(ret, sig) (((ret) << 8) | (sig))
+#endif
+
 #include <glib.h>
 #include <glib/gstdio.h>
 #include <gio/gio.h>
