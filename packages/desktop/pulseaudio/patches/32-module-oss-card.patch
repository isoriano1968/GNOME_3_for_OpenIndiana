+/*
+ * A card for the device with one output profile and the output ports.
+ * Clients such as libgnome-volume-control list a sink's ports only
+ * through its card: without one, a sink that has ports shows up nowhere.
+ */
+static pa_card *new_card(struct userdata *u, const char *dev, bool analog,
+                         const char *desc, const char *product,
+                         const char *form_factor, const char *icon) {
+    pa_card_new_data data;
+    pa_card_profile *profile;
+    pa_device_port *port;
+    pa_card *card;
+    void *state;
+    char *name;
+
+    pa_card_new_data_init(&data);
+    data.driver = __FILE__;
+    data.module = u->module;
+    name = pa_sprintf_malloc("oss_card.%s", pa_path_get_filename(dev));
+    pa_card_new_data_set_name(&data, name);
+    pa_xfree(name);
+    pa_proplist_sets(data.proplist, PA_PROP_DEVICE_STRING, dev);
+    pa_proplist_sets(data.proplist, PA_PROP_DEVICE_API, "oss");
+    pa_proplist_sets(data.proplist, PA_PROP_DEVICE_DESCRIPTION, desc);
+    if (product[0])
+        pa_proplist_sets(data.proplist, PA_PROP_DEVICE_PRODUCT_NAME, product);
+    if (form_factor)
+        pa_proplist_sets(data.proplist, PA_PROP_DEVICE_FORM_FACTOR, form_factor);
+    pa_proplist_sets(data.proplist, PA_PROP_DEVICE_ICON_NAME, icon);
+
+    if (analog)
+        add_output_ports(u, data.ports);
+    else
+        add_hdmi_port(u->core, data.ports);
+
+    profile = pa_card_profile_new(analog ? "output:analog-stereo" : "output:hdmi-stereo",
+                                  analog ? "Analog Stereo Output" : "Digital Stereo (HDMI) Output", 0);
+    profile->output_name = pa_xstrdup(analog ? "analog-stereo" : "hdmi-stereo");
+    profile->priority = 1;
+    profile->n_sinks = 1;
+    profile->max_sink_channels = 2;
+    profile->available = PA_AVAILABLE_UNKNOWN;
+    pa_hashmap_put(data.profiles, profile->name, profile);
+    PA_HASHMAP_FOREACH(port, data.ports, state)
+        pa_hashmap_put(port->profiles, profile->name, profile);
+
+    card = pa_card_new(u->core, &data);
+    pa_card_new_data_done(&data);
+    if (!card)
+        return NULL;
+
+    pa_card_choose_initial_profile(card);
+    pa_card_put(card);
+    return card;
 }
 
