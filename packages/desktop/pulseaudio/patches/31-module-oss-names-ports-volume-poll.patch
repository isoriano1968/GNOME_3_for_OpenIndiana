+/*
+ * illumos: describe the device, and give the sink "Speakers" and
+ * "Headphones" ports when its mixer has audiohd's "speaker" and
+ * "headphones" controls (audioctl show-control).  Choosing a port turns
+ * the other output's control down and the chosen one back up.  The
+ * hardware volume is polled, since OSS does not report mixer changes
+ * made by others (audioctl, mixer applets).
+ */
+
+#define PORT_SPEAKERS   0
+#define PORT_HEADPHONES 1
+#define VOLUME_POLL_USEC (1 * PA_USEC_PER_SEC)
+
+static const char *const port_ctrl_names[2] = { "speaker", "headphones" };
+
+/*
+ * The mixer node of an illumos dsp device: /dev/dspN -> sound/audiohd:0dsp
+ * -> /dev/sound/audiohd:0mixer.  SNDCTL_MIXERINFO with mi.dev = N is not
+ * reliable for this: on a machine with two audiohd instances, N = 0 gave
+ * the second device's mixer, so the built-in audio's volume slider moved
+ * the HDMI device's volume.
+ */
+static bool mixer_node_for_dsp(const char *dev, char *buf, size_t l) {
+    char *target, *t;
+    size_t n;
+
+    if (!(target = pa_readlink(dev)))
+        target = pa_xstrdup(dev);
+
+    n = strlen(target);
+    if (n < 3 || !pa_streq(target + n - 3, "dsp")) {
+        pa_xfree(target);
+        return false;
+    }
+    target[n - 3] = 0;
+    t = target;
+    if (t[0] == '/')
+        pa_snprintf(buf, l, "%smixer", t);
+    else {
+        while (pa_startswith(t, "../"))
+            t += 3;
+        pa_snprintf(buf, l, "/dev/%smixer", t);
+    }
+    pa_xfree(target);
+    return true;
+}
+
+/* Open the mixer of the OSS device "dev" (as pa__init does for volume). */
+static int open_device_mixer(const char *dev) {
+    struct oss_sysinfo si;
+    struct oss_mixerinfo mi;
+    char node[128];
+    int fd, xfd, n;
+
+    if (mixer_node_for_dsp(dev, node, sizeof(node)) &&
+        (xfd = pa_oss_open_mixer(node)) >= 0)
+        return xfd;
+
+    if ((fd = pa_oss_open_mixer_for_device(dev)) < 0)
+        return -1;
+
+    memset(&si, 0, sizeof(si));
+    memset(&mi, 0, sizeof(mi));
+    n = pa_oss_get_device_number(dev);
+    if (ioctl(fd, SNDCTL_SYSINFO, &si) < 0 || n < 0 || n >= si.nummixers) {
+        pa_close(fd);
+        return -1;
+    }
+    mi.dev = n;
+    if (ioctl(fd, SNDCTL_MIXERINFO, &mi) < 0) {
+        pa_close(fd);
+        return -1;
+    }
+    pa_close(fd);
+
+    xfd = pa_oss_open_mixer(mi.devnode);
+    return xfd;
+}
+
+/*
+ * Find the output controls.  Sets *analog when the device has any analog
+ * output control (an HDMI/DisplayPort codec only has the master volume).
+ */
+static void probe_output_controls(struct userdata *u, bool *analog) {
+    int i, n = -1;
+
+    u->port_ctrl[0] = u->port_ctrl[1] = -1;
+    *analog = false;
+
+    if (u->port_mixer_fd < 0 || ioctl(u->port_mixer_fd, SNDCTL_MIX_NREXT, &n) < 0)
+        return;
+
+    for (i = 0; i < n; i++) {
+        oss_mixext e;
+        int k;
+
+        memset(&e, 0, sizeof(e));
+        e.dev = -1;
+        e.ctrl = i;
+        if (ioctl(u->port_mixer_fd, SNDCTL_MIX_EXTINFO, &e) < 0)
+            continue;
+
+        if (pa_streq(e.extname, "speaker") || pa_streq(e.extname, "headphones") ||
+            pa_streq(e.extname, "front") || pa_streq(e.extname, "line-out") ||
+            pa_streq(e.extname, "rear") || pa_streq(e.extname, "surround"))
+            *analog = true;
+
+        for (k = 0; k < 2; k++)
+            if (pa_streq(e.extname, port_ctrl_names[k]) &&
+                (e.type == MIXT_STEREOSLIDER || e.type == MIXT_MONOSLIDER)) {
+                u->port_ctrl[k] = i;
+                u->port_type[k] = e.type;
+                u->port_max[k] = e.maxvalue;
+            }
+    }
+}
+
+static int read_ctrl(struct userdata *u, int k, int *value) {
+    oss_mixer_value v;
+
+    memset(&v, 0, sizeof(v));
+    v.dev = -1;
+    v.ctrl = u->port_ctrl[k];
+    if (ioctl(u->port_mixer_fd, SNDCTL_MIX_READ, &v) < 0)
+        return -1;
+    *value = v.value;
+    return 0;
+}
+
+static int write_ctrl(struct userdata *u, int k, int value) {
+    oss_mixer_value v;
+
+    memset(&v, 0, sizeof(v));
+    v.dev = -1;
+    v.ctrl = u->port_ctrl[k];
+    v.value = value;
+    if (ioctl(u->port_mixer_fd, SNDCTL_MIX_WRITE, &v) < 0) {
+        pa_log_warn("Failed to set mixer control %s: %s", port_ctrl_names[k], pa_cstrerror(errno));
+        return -1;
+    }
+    return 0;
+}
+
+static int sink_set_port_cb(pa_sink *s, pa_device_port *p) {
+    struct userdata *u;
+    int on, off, cur;
+
+    pa_assert_se(u = s->userdata);
+
+    on = (p == u->port[PORT_HEADPHONES]) ? PORT_HEADPHONES : PORT_SPEAKERS;
+    off = 1 - on;
+
+    /* Remember the level of the output that goes quiet. */
+    if (read_ctrl(u, off, &cur) >= 0 && cur != 0)
+        u->port_saved[off] = cur;
+    write_ctrl(u, off, 0);
+
+    /* Bring the chosen one back (75 %, audiohd's default, if it was 0). */
+    if (read_ctrl(u, on, &cur) >= 0 && cur == 0) {
+        int v = u->port_saved[on];
+
+        if (v == 0) {
+            v = u->port_max[on] * 3 / 4;
+            if (u->port_type[on] == MIXT_STEREOSLIDER)
+                v |= v << 8;
+        }
+        write_ctrl(u, on, v);
+    }
+
+    pa_log_info("Output port %s", p->name);
+    return 0;
+}
+
+static void add_output_ports(struct userdata *u, pa_sink_new_data *data) {
+    pa_device_port_new_data pd;
+    static const struct { const char *name, *desc; unsigned prio; } ports[2] = {
+        { "analog-output-speaker", "Speakers", 10000 },
+        { "analog-output-headphones", "Headphones", 9900 },
+    };
+    int k;
+
+    for (k = 0; k < 2; k++) {
+        pa_device_port_new_data_init(&pd);
+        pa_device_port_new_data_set_name(&pd, ports[k].name);
+        pa_device_port_new_data_set_description(&pd, ports[k].desc);
+        pa_device_port_new_data_set_direction(&pd, PA_DIRECTION_OUTPUT);
+        pa_device_port_new_data_set_available(&pd, PA_AVAILABLE_UNKNOWN);
+        u->port[k] = pa_device_port_new(u->core, &pd, 0);
+        pa_device_port_new_data_done(&pd);
+        u->port[k]->priority = ports[k].prio;
+        pa_hashmap_put(data->ports, u->port[k]->name, u->port[k]);
+        pa_device_port_ref(u->port[k]);
+    }
+}
+
+static void add_hdmi_port(pa_core *c, pa_sink_new_data *data) {
+    pa_device_port_new_data pd;
+    pa_device_port *port;
+
+    pa_device_port_new_data_init(&pd);
+    pa_device_port_new_data_set_name(&pd, "hdmi-output-0");
+    pa_device_port_new_data_set_description(&pd, "HDMI / DisplayPort");
+    pa_device_port_new_data_set_direction(&pd, PA_DIRECTION_OUTPUT);
+    pa_device_port_new_data_set_available(&pd, PA_AVAILABLE_UNKNOWN);
+    port = pa_device_port_new(c, &pd, 0);
+    pa_device_port_new_data_done(&pd);
+    pa_hashmap_put(data->ports, port->name, port);
+}
+
+/* Description and form factor from the driver's hardware info. */
+static void describe_device(int fd, bool analog, char *desc, size_t l,
+                            char *product, size_t pl, const char **form_factor,
+                            const char **icon) {
+    oss_card_info ci;
+    const char *codec = NULL;
+
+    memset(&ci, 0, sizeof(ci));
+    ci.card = -1;
+    product[0] = 0;
+    if (ioctl(fd, SNDCTL_CARDINFO, &ci) >= 0) {
+        ci.hw_info[sizeof(ci.hw_info) - 1] = 0;
+        ci.hw_info[strcspn(ci.hw_info, "\n")] = 0;
+        pa_strlcpy(product, ci.hw_info, pl);
+        if (pa_startswith(ci.hw_info, "HD codec: "))
+            codec = ci.hw_info + strlen("HD codec: ");
+        else if (pa_startswith(ci.hw_info, "AC'97 codec: "))
+            codec = ci.hw_info + strlen("AC'97 codec: ");
+    }
+
+    if (!analog) {
+        pa_snprintf(desc, l, "HDMI / DisplayPort Audio");
+        *form_factor = NULL;
+        *icon = "video-display";
+    } else if (pa_startswith(ci.shortname, "usb_ac")) {
+        pa_snprintf(desc, l, "USB Audio");
+        *form_factor = NULL;
+        *icon = "audio-card-usb";
+    } else {
+        if (codec && *codec)
+            pa_snprintf(desc, l, "Built-in Audio (%s)", codec);
+        else
+            pa_snprintf(desc, l, "Built-in Audio");
+        *form_factor = "internal";
+        *icon = "audio-card";
+    }
+}
+
+/*
+ * Mute in the hardware mixer, so that it also silences programs that use
+ * the OSS/Sun audio devices directly (audiotest, OSS players): the sink's
+ * volume control goes to 0, and back to PA's volume at unmute.  A change
+ * of that control by someone else (audioctl) while muted counts as unmute.
+ */
+static int mixer_raw_read(int fd, int ctrl, int *value) {
+    oss_mixer_value v;
+
+    memset(&v, 0, sizeof(v));
+    v.dev = -1;
+    v.ctrl = ctrl;
+    if (ioctl(fd, SNDCTL_MIX_READ, &v) < 0)
+        return -1;
+    *value = v.value;
+    return 0;
+}
+
+static int mixer_raw_write(int fd, int ctrl, int value) {
+    oss_mixer_value v;
+
+    memset(&v, 0, sizeof(v));
+    v.dev = -1;
+    v.ctrl = ctrl;
+    v.value = value;
+    return ioctl(fd, SNDCTL_MIX_WRITE, &v) < 0 ? -1 : 0;
+}
+
+static void sink_set_mute_cb(pa_sink *s) {
+    struct userdata *u;
+
+    pa_assert_se(u = s->userdata);
+
+    if (s->muted && !u->hw_muted) {
+        if (mixer_raw_write(u->mixer_dsp_fd, u->sink_mixext.ctrl, 0) < 0) {
+            pa_log_warn("Failed to mute %s: %s", u->device_name, pa_cstrerror(errno));
+            return;
+        }
+        u->hw_muted = true;
+    } else if (!s->muted && u->hw_muted) {
+        u->hw_muted = false;
+        if (pa_oss_set_volume(u->mixer_dsp_fd, &(u->sink_mixext), &s->sample_spec, &s->real_volume) < 0)
+            pa_log_warn("Failed to unmute %s: %s", u->device_name, pa_cstrerror(errno));
+    }
+}
+
+static int sink_get_mute_cb(pa_sink *s, bool *mute) {
+    struct userdata *u;
+    int v;
+
+    pa_assert_se(u = s->userdata);
+
+    if (u->hw_muted && mixer_raw_read(u->mixer_dsp_fd, u->sink_mixext.ctrl, &v) >= 0 && v != 0) {
+        /* Turned up by someone else: no longer muted. */
+        u->hw_muted = false;
+    }
+    *mute = u->hw_muted;
+    return 0;
+}
+
+static void volume_poll_cb(pa_mainloop_api *a, pa_time_event *e, const struct timeval *t, void *userdata) {
+    struct userdata *u = userdata;
+
+    pa_assert(u);
+
+    if (u->sink && u->sink->get_mute && PA_SINK_IS_LINKED(u->sink->state))
+        pa_sink_get_mute(u->sink, true);
+    if (u->sink && u->sink->get_volume && PA_SINK_IS_LINKED(u->sink->state))
+        pa_sink_get_volume(u->sink, true);
+    if (u->source && u->source->get_volume && PA_SOURCE_IS_LINKED(u->source->state))
+        pa_source_get_volume(u->source, true);
+
+    pa_core_rttime_restart(u->core, e, pa_rtclock_now() + VOLUME_POLL_USEC);
+}
