+
+static pa_available_t hdmi_available(struct userdata *u) {
+    if (u->hdmi_ctrl < 0)
+        return PA_AVAILABLE_UNKNOWN;
+    return u->hdmi_connected ? PA_AVAILABLE_YES : PA_AVAILABLE_NO;
+}
+
+/* audiohd's "hdmi-connected": 1 when a monitor is sensed on an HDMI/DP pin. */
+static int read_hdmi_connected(struct userdata *u) {
+    oss_mixer_value v;
+
+    memset(&v, 0, sizeof(v));
+    v.dev = -1;
+    v.ctrl = u->hdmi_ctrl;
+    if (u->hdmi_ctrl < 0 || ioctl(u->port_mixer_fd, SNDCTL_MIX_READ, &v) < 0)
+        return -1;
+    return v.value ? 1 : 0;
+}
+
+/*
+ * The connected monitors' names.  audiohd puts them into the device
+ * description, so CARDINFO's longname reads "DisplayPort: DELL U2713HM (a)"
+ * ("HDMI: <name>", several joined with ", ", or "<controller>, HDMI: <name>"
+ * on a mixed controller); without a monitor name it is the plain
+ * description ("onboard1 (a)").  Names are the items after "HDMI: " or
+ * "DisplayPort: ", joined with ", ".  Empty when there is none.
+ */
+static void hdmi_monitor_names(int fd, char *names, size_t l) {
+    oss_card_info ci;
+    char *item, *next, *paren;
+    size_t n;
+
+    names[0] = 0;
+    memset(&ci, 0, sizeof(ci));
+    ci.card = -1;
+    if (fd < 0 || ioctl(fd, SNDCTL_CARDINFO, &ci) < 0)
+        return;
+    ci.longname[sizeof(ci.longname) - 1] = 0;
+    if ((paren = strrchr(ci.longname, '(')) && paren > ci.longname && paren[-1] == ' ')
+        paren[-1] = 0;
+
+    for (item = ci.longname; item && *item; item = next) {
+        const char *name = NULL;
+
+        if ((next = strstr(item, ", "))) {
+            *next = 0;
+            next += 2;
+        }
+        if (pa_startswith(item, "HDMI: "))
+            name = item + strlen("HDMI: ");
+        else if (pa_startswith(item, "DisplayPort: "))
+            name = item + strlen("DisplayPort: ");
+        if (!name || !*name)
+            continue;
+        n = strlen(names);
+        pa_snprintf(names + n, l - n, "%s%s", n ? ", " : "", name);
+    }
+}
+
+/* The description of a digital device: its monitors, else the fallback. */
+static void hdmi_description(struct userdata *u, char *desc, size_t l) {
+    char names[128];
+
+    hdmi_monitor_names(u->port_mixer_fd, names, sizeof(names));
+    pa_strlcpy(desc, names[0] ? names : u->hdmi_fallback, l);
 }
 
