With the Online Accounts panel removed (13-disable-online-accounts), nothing
uses GNOME Online Accounts any more, but meson.build still requires goa-1.0.
Make it optional: OpenIndiana has no gnome-online-accounts (Solaris does).
OpenIndiana-only.

--- a/meson.build
+++ b/meson.build
@@ -124,7 +124,7 @@
 gnome_desktop_dep = dependency('gnome-desktop-3.0', version: '>= 3.33.4')
 gnome_settings_dep = dependency('gnome-settings-daemon', version: '>= 3.27.90')
-goa_dep = dependency('goa-1.0', version: goa_req_version)
+goa_dep = dependency('goa-1.0', version: goa_req_version, required: false)
 gsettings_desktop_dep = dependency('gsettings-desktop-schemas', version: '>= 40.alpha')
 libxml_dep = dependency('libxml-2.0')
 polkit_gobject_dep = dependency('polkit-gobject-1', version: '>= 0.114')
