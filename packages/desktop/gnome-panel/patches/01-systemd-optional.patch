gnome-panel: make libsystemd optional

The launcher, menu and lock-screen applets use libsystemd only to send the
output of the programs they start to the journal (sd_journal_stream_fd()
in child_setup()).  Systems without systemd (illumos, the BSDs) then cannot
build gnome-panel at all.  Check for libsystemd once, optionally
(--with-systemd=auto|yes|no), define HAVE_SYSTEMD, and without it leave the
started program's stdout/stderr as they are (the panel's, i.e. the session
log).  With libsystemd the result is the same as before.

Upstream: not yet sent (https://gitlab.gnome.org/GNOME/gnome-panel).

--- gnome-panel-3.50.0/configure.ac
+++ gnome-panel-3.50.0/configure.ac
@@ -166,10 +166,24 @@
   gio-unix-2.0 >= $GLIB_REQUIRED
   gtk+-3.0 >= $GTK_REQUIRED
   libgnome-menu-3.0 >= $LIBGNOME_MENU_REQUIRED
-  libsystemd >= $LIBSYSTEMD_REQUIRED
   x11
 ])
 
+dnl libsystemd is optional: with it, programs started from the panel log to
+dnl the journal; without it (no systemd), they keep the panel's stdout/stderr.
+AC_ARG_WITH([systemd],
+            [AS_HELP_STRING([--without-systemd],
+                            [do not send the output of started programs to the systemd journal])],
+            [with_systemd="$withval"], [with_systemd="auto"])
+AS_IF([test "x$with_systemd" != "xno"], [
+  PKG_CHECK_MODULES([SYSTEMD], [libsystemd >= $LIBSYSTEMD_REQUIRED],
+                    [have_systemd="yes"], [have_systemd="no"])
+  AS_IF([test "x$have_systemd" = "xno" && test "x$with_systemd" = "xyes"],
+        [AC_MSG_ERROR([libsystemd requested but not found])])
+], [have_systemd="no"])
+AS_IF([test "x$have_systemd" = "xyes"],
+      [AC_DEFINE([HAVE_SYSTEMD], [1], [Define if libsystemd is available])])
+
 PKG_CHECK_MODULES(FISH, gtk+-3.0 >= $GTK_REQUIRED cairo >= $CAIRO_REQUIRED)
 AC_SUBST(FISH_CFLAGS)
 AC_SUBST(FISH_LIBS)
@@ -178,7 +192,6 @@
   gio-unix-2.0 >= $GLIB_REQUIRED
   gtk+-3.0 >= $GTK_REQUIRED
   libgnome-menu-3.0 >= $LIBGNOME_MENU_REQUIRED
-  libsystemd >= $LIBSYSTEMD_REQUIRED
 ])
 
 PKG_CHECK_MODULES([MENU], [
@@ -186,7 +199,6 @@
   gio-unix-2.0 >= $GLIB_REQUIRED
   gtk+-3.0 >= $GTK_REQUIRED
   libgnome-menu-3.0 >= $LIBGNOME_MENU_REQUIRED
-  libsystemd >= $LIBSYSTEMD_REQUIRED
 ])
 
 PKG_CHECK_MODULES([NOTIFICATION_AREA], [
