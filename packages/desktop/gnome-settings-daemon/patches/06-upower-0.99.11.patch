OpenIndiana has upower 0.99.11; gnome-settings-daemon 45 asks for 0.99.12
only for the device kinds added then (pen, touchpad, headset, camera, ...).
A 0.99.11 daemon never reports those, so define them past
UP_DEVICE_KIND_LAST for older upower and accept 0.99.11.  OpenIndiana-only.

--- a/meson.build
+++ b/meson.build
@@ -106,7 +106,7 @@
 libpulse_mainloop_glib_dep = dependency('libpulse-mainloop-glib', version: '>= 2.0')
 pango_dep = dependency('pango', version: '>= 1.20.0')
 polkit_gobject_dep = dependency('polkit-gobject-1', version: '>= 0.114')
-upower_glib_dep = dependency('upower-glib', version: '>= 0.99.12')
+upower_glib_dep = dependency('upower-glib', version: '>= 0.99.11')
 x11_dep = dependency('x11')
 xfixes_dep = dependency('xfixes', version: '>= 6.0')
 
Common subdirectories: a/plugins and b/plugins
Common subdirectories: a/plugins/power and b/plugins/power
--- a/plugins/power/gsd-power-manager.c
+++ b/plugins/power/gsd-power-manager.c
@@ -27,6 +27,28 @@
 #include <glib/gi18n.h>
 #include <gtk/gtk.h>
 #include <libupower-glib/upower.h>
+
+/* OpenIndiana ships upower 0.99.11; the device kinds below came with
+ * 0.99.12.  An older daemon never reports them, so values past
+ * UP_DEVICE_KIND_LAST are enough for the name/icon switches here. */
+#if !UP_CHECK_VERSION(0, 99, 12)
+#define UP_DEVICE_KIND_PEN               (UP_DEVICE_KIND_LAST + 1)
+#define UP_DEVICE_KIND_TOUCHPAD          (UP_DEVICE_KIND_LAST + 2)
+#define UP_DEVICE_KIND_MODEM             (UP_DEVICE_KIND_LAST + 3)
+#define UP_DEVICE_KIND_NETWORK           (UP_DEVICE_KIND_LAST + 4)
+#define UP_DEVICE_KIND_HEADSET           (UP_DEVICE_KIND_LAST + 5)
+#define UP_DEVICE_KIND_SPEAKERS          (UP_DEVICE_KIND_LAST + 6)
+#define UP_DEVICE_KIND_HEADPHONES        (UP_DEVICE_KIND_LAST + 7)
+#define UP_DEVICE_KIND_VIDEO             (UP_DEVICE_KIND_LAST + 8)
+#define UP_DEVICE_KIND_OTHER_AUDIO       (UP_DEVICE_KIND_LAST + 9)
+#define UP_DEVICE_KIND_REMOTE_CONTROL    (UP_DEVICE_KIND_LAST + 10)
+#define UP_DEVICE_KIND_PRINTER           (UP_DEVICE_KIND_LAST + 11)
+#define UP_DEVICE_KIND_SCANNER           (UP_DEVICE_KIND_LAST + 12)
+#define UP_DEVICE_KIND_CAMERA            (UP_DEVICE_KIND_LAST + 13)
+#define UP_DEVICE_KIND_WEARABLE          (UP_DEVICE_KIND_LAST + 14)
+#define UP_DEVICE_KIND_TOY               (UP_DEVICE_KIND_LAST + 15)
+#define UP_DEVICE_KIND_BLUETOOTH_GENERIC (UP_DEVICE_KIND_LAST + 16)
+#endif
 #include <libnotify/notify.h>
 #include <canberra-gtk.h>
 #include <glib-unix.h>
