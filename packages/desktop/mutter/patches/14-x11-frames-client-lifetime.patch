+static gboolean
+frame_is_from_our_client (MetaX11Display *x11_display,
+                          Window          xwindow)
+{
+  Atom type;
+  int format;
+  unsigned long nitems, bytes_after;
+  unsigned char *data = NULL;
+  const char *ident;
+  gboolean ours = FALSE;
+
+  if (!x11_display->frames_client)
+    return FALSE;
+  ident = g_subprocess_get_identifier (x11_display->frames_client);
+  if (!ident)
+    return FALSE;
+
+  meta_x11_error_trap_push (x11_display);
+  if (XGetWindowProperty (x11_display->xdisplay, xwindow,
+                          x11_display->atom__NET_WM_PID,
+                          0, 1, False, XA_CARDINAL,
+                          &type, &format, &nitems, &bytes_after,
+                          &data) == Success &&
+      type == XA_CARDINAL && format == 32 && nitems == 1)
+    ours = ((unsigned long) *(long *) data ==
+            g_ascii_strtoull (ident, NULL, 10));
+  meta_x11_error_trap_pop (x11_display);
+
+  if (data)
+    XFree (data);
+  return ours;
+}
+
 static void
 handle_other_xevent (MetaX11Display *x11_display,
                      XEvent         *event)
@@ -1481,6 +1514,19 @@
