@@ -33,6 +34,22 @@
   return G_SOURCE_REMOVE;
 }
 
+/* The compositor stops us with SIGTERM when it exits cleanly. If it
+ * crashes, nothing does (there is no PR_SET_PDEATHSIG on illumos), and an
+ * orphaned frames client keeps framing the new compositor's windows.
+ * Exit once we have been reparented away from the process that started
+ * us.
+ */
+static pid_t parent_pid;
+
+static gboolean
+check_parent (gpointer user_data)
+{
+  if (getppid () != parent_pid)
+    exit (0);
+  return G_SOURCE_CONTINUE;
+}
+
 int
 main (int   argc,
       char *argv[])
@@ -63,6 +80,9 @@
 
   loop = g_main_loop_new (NULL, FALSE);
   g_unix_signal_add (SIGTERM, on_sigterm, NULL);
+  parent_pid = getppid ();
+  if (parent_pid != 1)
+    g_timeout_add_seconds (1, check_parent, NULL);
   g_main_loop_run (loop);
   g_main_loop_unref (loop);
 
--- mutter-45.7/src/x11/events.c.orig	Sun May 26 14:54:55 2024
+++ mutter-45.7/src/x11/events.c	Fri Nov 20 06:44:16 2026
@@ -1266,6 +1266,39 @@
     }
