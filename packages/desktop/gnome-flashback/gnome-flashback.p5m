set name=pkg.fmri value=pkg:/$(COMPONENT_FMRI)@$(IPS_COMPONENT_VERSION),$(BUILD_VERSION)
set name=pkg.human-version value=$(HUMAN_VERSION)
set name=pkg.summary value="$(COMPONENT_SUMMARY)"
set name=info.classification value="$(COMPONENT_CLASSIFICATION)"
set name=info.upstream-url value=$(COMPONENT_PROJECT_URL)
set name=info.source-url value=$(COMPONENT_ARCHIVE_URL)
set name=org.opensolaris.consolidation value=$(CONSOLIDATION)

license $(COMPONENT_LICENSE_FILE) license='$(COMPONENT_LICENSE)'

# the session (gnome-flashback-metacity.session) starts these by name, which
# pkgdepend cannot see
depend type=require fmri=gnome/gnome-session
depend type=require fmri=gnome/gnome-settings-daemon
depend type=require fmri=gnome/window-manager/metacity

file path=etc/pam.d/gnome-flashback mode=0644 preserve=true
file path=etc/xdg/autostart/gnome-flashback-clipboard.desktop
file path=etc/xdg/autostart/gnome-flashback-idle-monitor.desktop
file path=etc/xdg/autostart/gnome-flashback-media-keys.desktop
file path=etc/xdg/autostart/gnome-flashback-nm-applet.desktop
file path=etc/xdg/autostart/gnome-flashback-polkit.desktop
file path=etc/xdg/menus/gnome-flashback-applications.menu
file path=usr/bin/gnome-flashback
file path=usr/lib/$(MACH64)/gnome-panel/modules/system_indicators.so
file path=usr/libexec/gnome-flashback-clipboard
file path=usr/libexec/gnome-flashback-idle-monitor
file path=usr/libexec/gnome-flashback-media-keys
file path=usr/libexec/gnome-flashback-metacity
file path=usr/libexec/gnome-flashback-polkit
file path=usr/share/applications/gnome-flashback.desktop
file path=usr/share/desktop-directories/X-GNOME-Flashback-Settings-System.directory
file path=usr/share/desktop-directories/X-GNOME-Flashback-Settings.directory
