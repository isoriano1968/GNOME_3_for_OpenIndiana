 #include "gf-screensaver-utils.h"
 
+#ifdef HAVE_SYSTEMD
 #include <systemd/sd-login.h>
+#endif
 #include <unistd.h>
 
 gboolean
 gf_find_systemd_session (char **session_id)
 {
+#ifdef HAVE_SYSTEMD
   int n_sessions;
   char **sessions;
   char *session;
