 #include "gf-utils.h"
 
 #include <gio/gdesktopappinfo.h>
+#ifdef HAVE_SYSTEMD
 #include <systemd/sd-journal.h>
+#endif
 
 static void
 child_setup (gpointer user_data)
 {
+#ifdef HAVE_SYSTEMD
   GAppInfo *app_info;
   const gchar *id;
   gint stdout_fd;
@@ -45,6 +48,7 @@
       dup2 (stderr_fd, STDERR_FILENO);
       close (stderr_fd);
     }
+#endif
 }
 
