illumos port of the portal itself:
- no memfd_create() and no file sealing: sealed fds (icons, sounds) are
  refused with G_IO_ERROR_NOT_SUPPORTED instead of being taken unsealed;
- no O_PATH: only regular fds are accepted; the path of an fd is read from
  /proc/self/path/N (on illumos /proc/self/fd/N are not symlinks);
- no Linux statfs(): the NFS check of the permission store uses statvfs()
  f_basetype; the FUSE root checks of the (disabled) Flatpak/Linyaps code
  are left out;
- no d_type in struct dirent; _IO() comes from <sys/ioccom.h>;
- libglnx: loff_t for its copy_file_range() fallback, no fallocate();
- the trash portal is not registered: it needs Linux statx().

Not upstream yet; meant for https://github.com/flatpak/xdg-desktop-portal
(and libglnx, https://gitlab.gnome.org/GNOME/libglnx)

diff -ruN a/document-portal/permission-db.c b/document-portal/permission-db.c
--- a/document-portal/permission-db.c
+++ b/document-portal/permission-db.c
@@ -39,6 +39,9 @@
 #if HAVE_SYS_MOUNT_H
 #include <sys/mount.h>
 #endif
+#ifdef __sun
+#include <sys/statvfs.h>
+#endif
 
 struct PermissionDb
 {
@@ -244,11 +247,24 @@
 
   dirname = g_path_get_dirname (path);
 
+#ifdef __sun
+  /* illumos: the SVR4 statfs() has no f_type; statvfs() names the type */
+  {
+    struct statvfs statvfs_buffer;
+
+    (void) statfs_buffer;
+    (void) statfs_result;
+    if (statvfs (dirname, &statvfs_buffer) != 0)
+      return FALSE;
+    return strncmp (statvfs_buffer.f_basetype, "nfs", 3) == 0;
+  }
+#else
   statfs_result = statfs (dirname, &statfs_buffer);
   if (statfs_result != 0)
     return FALSE;
 
   return statfs_buffer.f_type == 0x6969;
+#endif
 }
 
