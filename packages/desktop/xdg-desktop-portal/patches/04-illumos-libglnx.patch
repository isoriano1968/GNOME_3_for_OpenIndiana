diff -ruN a/subprojects/libglnx/glnx-missing-syscall.h b/subprojects/libglnx/glnx-missing-syscall.h
--- a/subprojects/libglnx/glnx-missing-syscall.h
+++ b/subprojects/libglnx/glnx-missing-syscall.h
@@ -35,6 +35,14 @@
 #include <glib.h>
 #include <stdint.h>
 
+#ifdef __sun
+/* illumos has none of the Linux system calls wrapped below, and a system
+ * call number it does not know raises SIGSYS.  Make every one of them fail
+ * with ENOSYS, which the callers already handle.  (#undef at the end.) */
+#include <errno.h>
+#define syscall(...) (errno = ENOSYS, -1)
+#endif
+
 #if !HAVE_DECL_RENAMEAT2
 #  ifndef __NR_renameat2
 #    if defined __x86_64__
@@ -692,3 +700,7 @@
 }
 
 #endif
+
