--- a/subprojects/libglnx/glnx-missing.h
+++ b/subprojects/libglnx/glnx-missing.h
@@ -78,10 +78,18 @@
 #endif
 
 /* a horrid kludge trying to make sure that this will fail on old kernels */
-#ifndef O_TMPFILE
+/* (not on illumos: the Linux bit would mean something else there) */
+#if !defined(O_TMPFILE) && !defined(__sun)
 #define O_TMPFILE (__O_TMPFILE | O_DIRECTORY)
 #endif
 
+#if defined(__sun) && !defined(AT_EMPTY_PATH)
+/* illumos has no AT_EMPTY_PATH; a bit no illumos AT_* flag uses, so that
+ * the flag checks compile.  It only reaches the Linux system calls, which
+ * fail with ENOSYS on illumos (glnx-missing-syscall.h). */
+#define AT_EMPTY_PATH 0x40000000
+#endif
+
 #ifndef RENAME_NOREPLACE
 #define RENAME_NOREPLACE (1 << 0)
 #endif
