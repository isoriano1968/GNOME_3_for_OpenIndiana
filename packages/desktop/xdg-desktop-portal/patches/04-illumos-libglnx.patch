diff -ruN a/subprojects/libglnx/glnx-dirfd.h b/subprojects/libglnx/glnx-dirfd.h
--- a/subprojects/libglnx/glnx-dirfd.h
+++ b/subprojects/libglnx/glnx-dirfd.h
@@ -26,6 +26,12 @@
 #include <glnx-errors.h>
 #include <limits.h>
 #include <dirent.h>
+#ifdef __sun
+/* illumos: struct dirent has no d_type, so
+ * glnx_dirfd_iterator_next_dent_ensure_dtype() cannot fill it in; use
+ * glnx_dirent_is_dir() to ask whether an entry is a directory. */
+#define GLNX_DIRENT_NO_D_TYPE 1
+#endif
 #include <sys/stat.h>
 #include <fcntl.h>
 
@@ -136,4 +142,24 @@
 gboolean glnx_mkdtemp (const char *tmpl, int      mode,
                        GLnxTmpDir *out_tmpdir, GError **error);
 
+/**
+ * glnx_dirent_is_dir:
+ * @dfd: The directory the entry was read from
+ * @dent: An entry from glnx_dirfd_iterator_next_dent_ensure_dtype()
+ *
+ * Returns: %TRUE if @dent is a directory (not following symlinks)
+ */
+static inline gboolean
+glnx_dirent_is_dir (int dfd, struct dirent *dent)
+{
+#ifdef GLNX_DIRENT_NO_D_TYPE
+  struct stat stbuf;
+  return fstatat (dfd, dent->d_name, &stbuf, AT_SYMLINK_NOFOLLOW) == 0 &&
+         S_ISDIR (stbuf.st_mode);
+#else
+  (void) dfd;
+  return dent->d_type == DT_DIR;
+#endif
+}
+
 G_END_DECLS
