From 0567b512803c1cf52ffc11af4f0f06266530d9aa Mon Sep 17 00:00:00 2001
From: isoriano1968 <81116077+isoriano1968@users.noreply.github.com>
Date: Fri, 13 Nov 2026 20:48:12 +0100
Subject: [PATCH] NNNNN hal automounts EFI system partitions (no
 volume.partition.type for GPT)

---
 .../policy/10osvendor/20-storage-methods.fdi  |  6 +++++
 usr/src/cmd/hal/probing/volume/probe-volume.c | 26 +++++++++++++++++++
 2 files changed, 32 insertions(+)

diff --git a/usr/src/cmd/hal/fdi/policy/10osvendor/20-storage-methods.fdi b/usr/src/cmd/hal/fdi/policy/10osvendor/20-storage-methods.fdi
index f722dfb2..1e1ff381 100644
--- a/usr/src/cmd/hal/fdi/policy/10osvendor/20-storage-methods.fdi
+++ b/usr/src/cmd/hal/fdi/policy/10osvendor/20-storage-methods.fdi
@@ -77,6 +77,12 @@
       <!-- amd mount programs (e.g. Mount() on HAL) to respect volume.ignore -->
       <merge key="volume.ignore" type="bool">false</merge>
 
+      <!-- EFI system partitions (GPT type C12A7328-...), on any disk, -->
+      <!-- removable or not: firmware files, never a user volume -->
+      <match key="volume.partition.type" string="C12A7328-F81F-11D2-BA4B-00A0C93EC93B">
+        <merge key="volume.ignore" type="bool">true</merge>
+      </match>
+
       <match key="@block.storage_device:storage.removable" bool="false">
 
         <!-- Should always ignore Apple Bootstrap partitions (it would be -->
diff --git a/usr/src/cmd/hal/probing/volume/probe-volume.c b/usr/src/cmd/hal/probing/volume/probe-volume.c
index 2a329574..ef6f550d 100644
--- a/usr/src/cmd/hal/probing/volume/probe-volume.c
+++ b/usr/src/cmd/hal/probing/volume/probe-volume.c
@@ -598,6 +598,32 @@ main (int argc, char *argv[])
 					HAL_DEBUG (("zero size partition"));
 				}
 				partition_start = gpt->efi_parts[partition_number].p_start * block_size;
+				{
+					/*
+					 * The partition type GUID, as HAL specifies
+					 * volume.partition.type for GPT; policy uses it
+					 * e.g. to ignore EFI system partitions.
+					 */
+					struct uuid *g =
+					    &gpt->efi_parts[partition_number].p_guid;
+					char type[37];
+
+					(void) snprintf(type, sizeof (type),
+					    "%08X-%04X-%04X-%02X%02X-"
+					    "%02X%02X%02X%02X%02X%02X",
+					    g->time_low, g->time_mid,
+					    g->time_hi_and_version,
+					    g->clock_seq_hi_and_reserved,
+					    g->clock_seq_low, g->node_addr[0],
+					    g->node_addr[1], g->node_addr[2],
+					    g->node_addr[3], g->node_addr[4],
+					    g->node_addr[5]);
+					dbus_error_init(&error);
+					libhal_device_set_property_string(ctx,
+					    udi, "volume.partition.type", type,
+					    &error);
+					my_dbus_error_free(&error);
+				}
 			}
 			efi_free(gpt);
 		}
